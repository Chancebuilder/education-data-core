# Local development only. Do not put production passwords or Supabase service-role keys here.
# Copy to .env. The migrator role is used for migrations, ingestion, and tests.
# The API role cannot bypass row level security.

DATABASE_URL=postgres://edu_migrator:edu_migrator@127.0.0.1:5432/education_data_core
API_DATABASE_URL=postgres://edu_api:edu_api@127.0.0.1:5432/education_data_core
PORT=43123

# Supabase production notes (leave empty locally):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Never ship SUPABASE_SERVICE_ROLE_KEY to a browser, mobile client, or this repository.
